{
  "name": "rss-news-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "pipeline": "tsx src/pipeline/index.ts",
    "rescore": "tsx src/pipeline/rescore.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt src tests scripts",
    "fmt:check": "oxfmt --check src tests scripts",
    "lint:tf": "terraform fmt -check -recursive terraform",
    "fmt:tf": "terraform fmt -recursive terraform",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm lint:tf && pnpm pinact:check && pnpm test && pnpm test:worker",
    "pinact": "pinact run .github/workflows/*.yml",
    "pinact:check": "pinact run --check --verify .github/workflows/*.yml",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "coverage:report": "node scripts/coverage-summary.mjs",
    "e2e:seed": "tsx tests/e2e/seed.ts",
    "e2e:server": "pnpm build && pnpm e2e:seed && wrangler dev --config wrangler.e2e.jsonc --port 8787 --ip 127.0.0.1"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  }
}
