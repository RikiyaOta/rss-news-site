{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rss-news-site",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "rss-news.rikiyaota.kyoto",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rss-news-db",
      "database_id": "6dd20c3e-f4ea-4ac9-a391-6da5e05ddef5",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
